{
  "name": "frameforge-studio",
  "version": "0.1.1",
  "private": true,
  "author": "Sheldon23357",
  "license": "MIT",
  "description": "帧叙 — Interactive film authoring studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sheldon23357/FrameForge.git"
  },
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "main": "dist-desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run build:web-player && vite --host 127.0.0.1",
    "build:web-player": "node scripts/build-web-player.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && npm run build:web-player && vite build && node scripts/build-desktop.mjs",
    "start": "electron .",
    "package": "npm run build && electron-builder --win dir",
    "test:e2e": "playwright test",
    "format": "prettier --write src packages desktop scripts tests *.ts *.json index.html",
    "icon": "node scripts/create-icon.mjs",
    "licenses": "node scripts/licenses.mjs"
  },
  "build": {
    "appId": "studio.frameforge.desktop",
    "productName": "帧叙",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-desktop/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "skills",
        "to": "bundled-skills",
        "filter": ["**/*.md", "!**/assets/example-*.md"]
      }
    ],
    "extraFiles": [
      {
        "from": "public/THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "docs/editor-guide.md",
        "to": "使用说明.md"
      }
    ],
    "asar": true,
    "win": {
      "executableName": "FrameForge",
      "icon": "build/icon.ico",
      "target": [
        "dir"
      ],
      "signExecutable": false
    }
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@xyflow/react": "^12.12.1",
    "fflate": "^0.8.3",
    "js-yaml": "4.3.2",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
